# Copy to .env and edit before production use.

# REQUIRED: long random string (e.g. openssl rand -hex 32)
SESSION_SECRET=change-me-generate-a-long-random-secret

# Absolute path to CCTV footage on the Debian host
FOOTAGE_ROOT=/var/lib/cctv-footage

# App data (users.json lives here)
DATA_DIR=/var/lib/fileserver

APP_NAME=FileServer
HOST=127.0.0.1
PORT=8080

# Set true only when nginx (or similar) sets X-Forwarded-For
TRUST_PROXY_HEADERS=true

SESSION_HOURS=12
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=300
